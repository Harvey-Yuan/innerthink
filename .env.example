INNERTHINK_MODEL_ID=cds-jb/codi_qwen3-8b-answer_only
INNERTHINK_BASE_MODEL_ID=Qwen/Qwen3-8B
INNERTHINK_DEVICE=mps
INNERTHINK_DTYPE=float16
INNERTHINK_MAX_PROMPT_TOKENS=1024
INNERTHINK_MAX_NEW_TOKENS=128
INNERTHINK_LATENT_ITERATIONS=6
INNERTHINK_API_URL=http://127.0.0.1:8000
INNERTHINK_API_TIMEOUT_SECONDS=600

# EverOS runs separately from the model API. Port 8001 avoids a local conflict.
EVEROS_ROOT=./data/everos
EVEROS_API__HOST=127.0.0.1
EVEROS_API__PORT=8001
INNERTHINK_EVEROS_URL=http://127.0.0.1:8001
INNERTHINK_EVEROS_TIMEOUT_SECONDS=120
INNERTHINK_EVEROS_APP_ID=innerthink
INNERTHINK_EVEROS_PROJECT_ID=default

# Optional Snowflake token-economy telemetry. Prompts and answers are hashed.
INNERTHINK_SNOWFLAKE_ENABLED=false
INNERTHINK_SNOWFLAKE_TABLE=INFERENCE_EVENTS
# Use the connector account identifier: organization-account (not a Snowsight URL).
# A copied Snowsight path such as organization/account is accepted too.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
